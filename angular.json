{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "decimal-wheel-picker": {
      "projectType": "library",
      "root": "projects/decimal-wheel-picker",
      "sourceRoot": "projects/decimal-wheel-picker/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "projects/decimal-wheel-picker/tsconfig.lib.json",
            "project": "projects/decimal-wheel-picker/ng-package.json"
          }
        }
      }
    },
    "decimal-wheel-picker-demo": {
      "projectType": "application",
      "root": "projects/decimal-wheel-picker-demo",
      "sourceRoot": "projects/decimal-wheel-picker-demo/src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/decimal-wheel-picker-demo",
            "index": "projects/decimal-wheel-picker-demo/src/index.html",
            "main": "projects/decimal-wheel-picker-demo/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/decimal-wheel-picker-demo/tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "decimal-wheel-picker-demo:build"
          }
        }
      }
    }
  },
  "defaultProject": "decimal-wheel-picker-demo"
}
